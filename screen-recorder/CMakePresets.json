{
  "version": 2,
  "configurePresets": [
    {
      "name": "mingw-release",
      "displayName": "MinGW Release (Static)",
      "description": "Build with MinGW-w64 GCC for Windows, static linking, release mode",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXE_LINKER_FLAGS": "-static-libgcc -static-libstdc++ -static",
        "FFMPEG_DIR": {
          "type": "PATH",
          "value": "$env{FFMPEG_DIR}"
        }
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "MinGW Debug",
      "description": "Build with MinGW-w64 GCC for Windows, debug mode",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "Release Build",
      "configurePreset": "mingw-release"
    },
    {
      "name": "debug",
      "displayName": "Debug Build",
      "configurePreset": "mingw-debug"
    }
  ]
}
